                android:startColor="#26D97706"
                android:endColor="#000F172A" />
        </aapt:attr>
    </path>

    <!-- Outer Geofence Perimeter (Dashed ring) -->
    <path
        android:pathData="M54,16 A38,38 0 1,0 54,92 A38,38 0 1,0 54,16 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#334155"
        android:strokeAlpha="0.6"
        android:fillColor="#00000000" />

    <!-- Mid Geofence Radar Circle -->
    <path
        android:pathData="M54,26 A28,28 0 1,0 54,82 A28,28 0 1,0 54,26 Z"
        android:strokeWidth="1.0"
        android:strokeColor="#1E293B"
        android:strokeAlpha="0.8"
